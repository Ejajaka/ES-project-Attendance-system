# Dependencies
node_modules/
.expo/
dist/
*.tsbuildinfo

# Native (Expo generates these via `expo prebuild`; commit only truly custom changes)
/app/android/
/app/ios/
*.keystore
google-services.json

# Gradle build output inside the native modules
/app/modules/*/android/build/
/app/modules/*/ios/build/

# Env / secrets
.env
.env.*
!.env.example
*.pem

# Agent skill tooling (machine-local; re-install via `npx skills experimental_install`)
.agents/
.claude/
agent/

# Logs & OS
npm-debug.log*
.DS_Store
*.log

# Data collected during experiments
/evaluation/runs/
*.csv.tmp

# Server runtime persistence (JSON store written when SHUSSEKI_DATA is set)
/server/store.json
/server/*.log

# Editor
.vscode/
.idea/

# local scratch (this branch)
.tmp/

# Python bytecode
__pycache__/
*.pyc
