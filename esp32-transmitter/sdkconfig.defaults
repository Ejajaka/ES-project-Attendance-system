# Shusseki ESP32 transmitter — sdkconfig overrides.
# Applied by PlatformIO when sdkconfig.<env> is (re)generated.

# 4 MB flash (most ESP32-WROOM devkits). Change if your module is 2 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Bluetooth LE (Bluedroid host) — the room beacon carrying "<nodeId>|<code>".
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y

# WiFi + BLE software coexistence: the SoftAP serves receivers while BLE advertises.
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# WPA2-Enterprise (802.1X / EAP-PEAP) STA support, to join the campus WiFi.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y

# IP forwarding + NAT so phones joined to the SoftAP can reach the fusion server
# on the STA-side network (wire-free topology: phone -> room AP -> hotspot -> PC).
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
